# ===== imgdrop 設定檔 =====
# 複製為 .env 後修改：cp .env.example .env

# --- 必填 ---
# 上傳碼：任何人上傳圖片都要輸入這組碼（不分大小寫）
UPLOAD_CODE=change-me-please

# --- 建議設定 ---
# 網站名稱（顯示在頁面標題）
SITE_NAME=圖片上傳

# 服務埠（阿里雲安全組要放行同一個埠）
PORT=3000

# 每張圖片預設保存時數 / 最長可選時數
DEFAULT_EXPIRE_HOURS=24
MAX_EXPIRE_HOURS=168

# 前端可選的保存時間（小時，逗號分隔）
ALLOWED_EXPIRE_HOURS=1,6,24,72,168

# --- 選填 ---
# 管理金鑰：設定後可用 /api/stats 看用量、POST /api/admin/cleanup 手動清理
# 產生方式：openssl rand -hex 24
ADMIN_KEY=

# 單張圖片大小上限（bytes），預設 20 MB
MAX_FILE_BYTES=20971520

# 圖片總容量配額（bytes），預設 2 GB；超過就拒絕新上傳
MAX_TOTAL_BYTES=2147483648

# 圖片張數上限
MAX_PHOTOS=20000

# 是否開放「全部照片」共用相簿分頁（true / false）
PUBLIC_GALLERY=true

# 每個 IP 每小時可上傳張數
MAX_UPLOADS_PER_HOUR=120

# 前面有 Nginx / Caddy 反向代理時設 true，才能取到真實訪客 IP
TRUST_PROXY=false

# 資料存放位置（預設 ./data）
# DATA_DIR=/var/lib/imgdrop

# 是否記錄每個請求（除錯用）
LOG_REQUESTS=false
